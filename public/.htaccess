# pdf.js loads its worker as an ES module (`new Worker(url, { type: "module" })`),
# and browsers refuse to execute a module script unless the server declares it
# with a JavaScript MIME type. Many Apache/LiteSpeed configs (Hostinger's shared
# hosting included) don't map .mjs by default and fall back to
# application/octet-stream, which silently breaks every PDF the app tries to open.
<IfModule mod_mime.c>
  AddType text/javascript .mjs
  AddType application/wasm .wasm
  AddType application/manifest+json .webmanifest
</IfModule>

# Vite fingerprints filenames, so assets are safe to cache aggressively.
<IfModule mod_expires.c>
  ExpiresActive On
  <FilesMatch "\.(js|mjs|css|woff2?)$">
    ExpiresDefault "access plus 1 year"
  </FilesMatch>
</IfModule>

# The site also answers on www. — send it to the one canonical host so search
# engines don't see two copies of every page.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]
</IfModule>
